---
const items = Array.from({ length: 8 }, () => "Nejlepší pobyt na světě");
---

<div
  class="marquee absolute inset-x-0 bottom-0 z-20 overflow-hidden bg-forest-700/85 backdrop-blur-sm border-y border-cream-50/15 py-3 sm:py-4"
  aria-label="Nejlepší pobyt na světě"
>
  <div class="marquee__track flex gap-12 sm:gap-16 whitespace-nowrap" aria-hidden="true">
    {[...items, ...items].map((text) => (
      <span class="font-display text-cream-50 text-2xl sm:text-3xl tracking-wide flex items-center gap-12 sm:gap-16">
        {text}
        <span class="text-cream-50/60" aria-hidden="true">★</span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee-slide {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }

  .marquee__track {
    width: max-content;
    animation: marquee-slide 35s linear infinite;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
      transform: translateX(-25%);
    }
  }
</style>
