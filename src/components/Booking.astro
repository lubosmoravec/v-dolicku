---
---

<section id="rezervace" class="py-24 sm:py-32 bg-cream-100">
  <div class="max-w-3xl mx-auto px-5 sm:px-8">
    <div class="text-center mb-12">
      <p class="text-forest-500 uppercase tracking-widest text-xs mb-4">Rezervace</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl text-forest-700 leading-tight">
        Rezervovat pobyt
      </h2>
      <p class="mt-6 text-lg text-forest-700/80 leading-relaxed">
        Napište nám, kdy byste rádi přijeli. Co nejdříve se vám ozveme s
        potvrzením a dalšími informacemi.
      </p>
    </div>

    <form
      class="bg-white/70 border border-cream-200 rounded-sm p-6 sm:p-10 grid gap-5"
      action="TODO_FORM_ENDPOINT"
      method="post"
    >
      <!-- TODO: doplnit endpoint formuláře (např. Formspree, Web3Forms, vlastní /api endpoint).
           Validace se musí provádět také server-side. -->

      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="block text-sm text-forest-700 mb-1.5">Jméno a příjmení</span>
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 placeholder:text-forest-700/40 focus:outline-none focus:border-forest-500"
            placeholder="Vaše jméno"
          />
        </label>
        <label class="block">
          <span class="block text-sm text-forest-700 mb-1.5">E-mail</span>
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 placeholder:text-forest-700/40 focus:outline-none focus:border-forest-500"
            placeholder="vas@email.cz"
          />
        </label>
      </div>

      <label class="block">
        <span class="block text-sm text-forest-700 mb-1.5">Telefon (nepovinné)</span>
        <input
          type="tel"
          name="phone"
          autocomplete="tel"
          class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 placeholder:text-forest-700/40 focus:outline-none focus:border-forest-500"
          placeholder="+420"
        />
      </label>

      <div class="grid sm:grid-cols-3 gap-5">
        <label class="block">
          <span class="block text-sm text-forest-700 mb-1.5">Příjezd</span>
          <input
            type="date"
            name="arrival"
            required
            class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 focus:outline-none focus:border-forest-500"
          />
        </label>
        <label class="block">
          <span class="block text-sm text-forest-700 mb-1.5">Odjezd</span>
          <input
            type="date"
            name="departure"
            required
            class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 focus:outline-none focus:border-forest-500"
          />
        </label>
        <label class="block">
          <span class="block text-sm text-forest-700 mb-1.5">Počet hostů</span>
          <select
            name="guests"
            class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 focus:outline-none focus:border-forest-500"
          >
            <option value="2">2 osoby</option>
            <option value="1">1 osoba</option>
          </select>
        </label>
      </div>

      <label class="block">
        <span class="block text-sm text-forest-700 mb-1.5">Vzkaz (nepovinné)</span>
        <textarea
          name="message"
          rows="4"
          class="w-full bg-cream-50 border border-cream-200 rounded-sm px-4 py-3 text-forest-700 placeholder:text-forest-700/40 focus:outline-none focus:border-forest-500 resize-y"
          placeholder="Něco navíc, co bychom měli vědět?"
        ></textarea>
      </label>

      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pt-2">
        <p class="text-sm text-forest-700/60">
          Odesláním souhlasíte s tím, že vás kontaktujeme ohledně rezervace.
        </p>
        <button
          type="submit"
          class="inline-flex items-center justify-center bg-forest-600 hover:bg-forest-700 text-cream-50 px-7 py-3.5 rounded-full font-medium transition-colors"
        >
          Odeslat poptávku
        </button>
      </div>
    </form>
  </div>
</section>
